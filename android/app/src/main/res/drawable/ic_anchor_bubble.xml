<?xml version="1.0" encoding="utf-8"?>
<!-- Simple anchor glyph (ring, shaft, curved flukes). Arc flags are fully
     space-separated ("0 0 2 -1.998" not "002-1.998") — Android's
     VectorDrawable path parser is stricter than browser SVG parsers about
     this compact notation and can fail to inflate the drawable entirely,
     silently crashing whatever created it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="56dp"
    android:height="56dp"
    android:viewportWidth="15"
    android:viewportHeight="15">
    <path
        android:pathData="M7.5 4.497 a2 2 0 0 0 2 -1.998 a2 2 0 0 0 -4 0 a2 2 0 0 0 2 1.998 Z m0 0 v9.994 m0 0 c-3.866 0 -7 -3.132 -7 -6.996 h2 m5 6.996 c3.866 0 7 -3.132 7 -6.996 h-2"
        android:strokeColor="#FF9F7A"
        android:strokeWidth="1.3"
        android:strokeLineCap="square"
        android:fillColor="#00000000" />
</vector>
