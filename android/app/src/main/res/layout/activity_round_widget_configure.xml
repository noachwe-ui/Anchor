<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FAF8F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Anchor Shortcut"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#3D3A36" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:text="Choose what this round button does"
        android:textColor="#8A847C" />

    <Button
        android:id="@+id/btn_open_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Anchor"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_open_clip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Watch a Clip (direct link)" />
</LinearLayout>
